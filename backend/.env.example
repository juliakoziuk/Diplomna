# Copy this file to backend/.env (local dev) or set the same names as environment
# variables on the hosting (production). Neither .env nor .env.local is committed.

# --- Core (required) ---
DATABASE_URL=postgresql://johndoe:123@localhost:5433/chatapp
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
# true for a hosted Postgres reached over the public internet (Neon, Supabase...)
DATABASE_SSL=false
# Hosting platforms set PORT themselves
# PORT=3000
# Extra browser origins allowed to call the API (only needed if the frontend is hosted elsewhere)
# CORS_ORIGINS=https://app.example.com
# Production only (enables Secure cookies, which need HTTPS); the Docker image sets it itself
# NODE_ENV=production

# --- Billing: leave all STRIPE_* empty to run without payments (Free plan only) ---

# --- Billing (Stripe TEST mode) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# printed by: stripe listen --forward-to localhost:3000/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# filled in automatically by: npm run stripe:setup
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_SEARCH=
STRIPE_PORTAL_CONFIG=

# Where Stripe sends the user back after checkout / portal
FRONTEND_URL=http://localhost:5173

# --- Anchor API ---
# How often pending document hashes are batched and anchored (ms)
ANCHOR_EPOCH_MS=60000
